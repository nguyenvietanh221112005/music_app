<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@android:color/white">

        <!-- Ảnh bìa nhạc -->
        <ImageView
            android:id="@+id/imgBiaNhac"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh bìa bài hát"
            android:background="@drawable/rounded_image_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/music_placeholder" />

        <!-- Tên bài hát -->
        <TextView
            android:id="@+id/tvTenBaiHat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tên bài hát"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/imgBiaNhac"
            app:layout_constraintTop_toTopOf="@id/imgBiaNhac"
            app:layout_constraintEnd_toStartOf="@id/imgTimYeuThich" />

        <!-- Tên ca sĩ -->
        <TextView
            android:id="@+id/tvTenCaSi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tên ca sĩ"
            android:textColor="#7A7A7A"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/imgBiaNhac"
            app:layout_constraintTop_toBottomOf="@id/tvTenBaiHat"
            app:layout_constraintBottom_toBottomOf="@id/imgBiaNhac"
            app:layout_constraintEnd_toStartOf="@id/imgTimYeuThich" />

        <!-- Icon tim yêu thích -->
        <ImageView
            android:id="@+id/imgTimYeuThich"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:contentDescription="Yêu thích"
            app:srcCompat="@drawable/ic_heart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgBiaNhac"
            app:layout_constraintBottom_toBottomOf="@id/imgBiaNhac" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>