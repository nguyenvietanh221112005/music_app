<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Ảnh bìa -->
    <ImageView
        android:layout_marginLeft="4dp"
        android:id="@+id/imgBiaNhac"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/music_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Tên bài hát -->
    <TextView
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:id="@+id/tvTenBaiHat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="     Tên bài hát"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/imgBiaNhac"
        app:layout_constraintTop_toTopOf="@id/imgBiaNhac"
        app:layout_constraintEnd_toStartOf="@id/imgTimYeuThich" />

    <!-- Ca sĩ -->
    <TextView
        android:layout_marginLeft="12dp"
        android:id="@+id/tvTenCaSi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="      Ca sĩ"
        android:textColor="#e2e1e6"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/imgBiaNhac"
        app:layout_constraintTop_toBottomOf="@id/tvTenBaiHat"
        app:layout_constraintBottom_toBottomOf="@id/imgBiaNhac"
        app:layout_constraintEnd_toStartOf="@id/imgTimYeuThich" />

    <!-- Tim yêu thích -->
    <ImageView
        android:id="@+id/imgTimYeuThich"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:contentDescription="yêu thích"
        app:srcCompat="@drawable/ic_heart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgBiaNhac"
        app:layout_constraintBottom_toBottomOf="@id/imgBiaNhac" />

</androidx.constraintlayout.widget.ConstraintLayout>