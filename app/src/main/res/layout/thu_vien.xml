<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutSearchThuVienMusic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/thu_vien_cua_toi"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- RecyclerView: nằm bên dưới AppBar và dừng ở đáy parent -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerThuVien"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBarLayoutSearchThuVienMusic"
        android:layout_alignParentBottom="true"
        android:padding="8dp"
        android:scrollbars="vertical"/>
</RelativeLayout>
